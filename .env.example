# Local evaluation configuration (copy values into your shell or a local .env loader).
# Do not commit real secrets. P0-001 has no individual credentials.

HOST=127.0.0.1
PORT=8787
DB_PATH=runtime/dev.sqlite
HOUSEHOLD_TIMEZONE=America/New_York

# Set to 1 only for deliberate trusted-LAN evaluation. Default is loopback-only.
EVAL_LAN_ACCESS=0

# NODE_ENV=production is used by `npm run start` after build.
