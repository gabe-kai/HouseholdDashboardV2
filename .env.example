# Local / hosted configuration placeholders (no secrets).

HOST=127.0.0.1
PORT=8787
DB_PATH=runtime/dev.sqlite
BACKUP_DIR=runtime/backups
HOUSEHOLD_TIMEZONE=America/New_York

# development | test | hosted
APP_PROFILE=development

# Hosted-only (required when APP_PROFILE=hosted)
# PUBLIC_ORIGIN=https://family.example.invalid
# TRUSTED_PROXY=1

# Development convenience (forbidden in hosted)
AUTO_SEED=1
EVAL_LAN_ACCESS=0
